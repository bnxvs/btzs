# Пример окружения для docker-развёртывания Plotter.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Значения ниже — по умолчанию; меняйте по необходимости.

# Порт, на котором приложение публикуется на хост.
# Nginx Proxy Manager (в режиме network_mode: host) проксирует на
# `http://127.0.0.1:<PLOTTER_PORT>`. Выберите свободный порт:
#   ss -ltn | grep :<порт>
PLOTTER_PORT=8080

# Интерфейс публикации. По умолчанию — только loopback (безопасно, если
# доступ идёт через NPM на том же хосте). Для прямого доступа извне
# без прокси поставьте 0.0.0.0.
PLOTTER_BIND=127.0.0.1
