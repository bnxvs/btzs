# Пример окружения для docker-развёртывания Plotter.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Значения ниже — по умолчанию; меняйте по необходимости.

# Адрес и порт публикации контейнера на хосте.
# За Nginx Proxy Manager или иным хост-прокси оставьте привязку к localhost.
# Для прямого доступа извне: PLOTTER_BIND=0.0.0.0, PLOTTER_PORT=80.
PLOTTER_BIND=127.0.0.1
PLOTTER_PORT=8080

# Имя внешней docker-сети, в которой работает Nginx Proxy Manager
# (используется только при `./scripts/deploy.sh --npm`).
# NPM_NETWORK=npm_default
